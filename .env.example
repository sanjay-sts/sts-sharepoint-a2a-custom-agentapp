# Copy to .env in the repo root (next to pyproject.toml). .env is gitignored.
# Every module loads it from there via load_dotenv().

# --- Entra ID / Microsoft Graph (required) ---
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client secret for the app registration (client-credential flow in sp_graph).
CLIENT_SECRET=

# --- Amazon Bedrock (required by the agent) ---
AWS_REGION=us-east-1
# Model or inference profile ID. Ask the owner; do not guess.
BEDROCK_MODEL_ID=

# Credentials: the SSO profile to use (aws sso login --profile <name>).
# Leave AWS_PROFILE blank to use the default credential chain, or set
# AWS_BEARER_TOKEN_BEDROCK instead of a profile.
AWS_PROFILE=
#AWS_BEARER_TOKEN_BEDROCK=

# --- A2A server (required by agent/a2a_server.py) ---
# Origin allowed by CORS; no trailing slash needed.
SHAREPOINT_ORIGIN=https://yourtenant.sharepoint.com

# --- MCP server URL the agent calls (optional) ---
#MCP_URL=http://127.0.0.1:8001/mcp
